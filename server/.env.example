# ── M-Pesa Daraja ────────────────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=your_shortcode_here
MPESA_PASSKEY=your_passkey_here

# "sandbox" for testing, "live" for production
MPESA_ENV=sandbox

# ── Auth ──────────────────────────────────────────────────────────────────────
# A long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Your Railway deployment URL (set this after deploying to Railway)
# e.g. https://prelovedstore-server-production.up.railway.app
RAILWAY_URL=https://your-railway-url.up.railway.app

# Your frontend URL (Vercel URL — for CORS)
# e.g. https://legendary-seven.vercel.app
FRONTEND_URL=https://your-vercel-url.vercel.app
